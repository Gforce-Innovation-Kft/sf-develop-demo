{
  "name": "Salesforce Development",
  "image": "gforceinnovation/sf-devcontainer:latest",

  // Org auth lives in named Docker volumes, NOT a bind mount of the host's
  // ~/.sf or ~/.sfdx. Those files are encrypted with the HOST OS's keychain
  // (e.g. macOS Keychain), which this Linux container cannot read — bind-mounting
  // them in causes every org to fail `sf org list` with AuthDecryptError. Log in
  // once *inside* the container (see .devcontainer/post-create.sh); the named
  // volumes below keep it there across rebuilds, isolated from host credentials.
  "mounts": [
    "source=sf-develop-demo-sf-config,target=/home/vscode/.sf,type=volume",
    "source=sf-develop-demo-sfdx-config,target=/home/vscode/.sfdx,type=volume",
    "source=sf-develop-demo-history,target=/commandhistory,type=volume"
  ],

  // .sf/ is gitignored, so a fresh clone has no target-org. This committed
  // alias is what makes the default survive cloning.
  "containerEnv": {
    "SF_DEFAULT_ORG_ALIAS": "github1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "salesforce.salesforcedx-vscode-expanded",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.vscode-xml",
        "github.copilot"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "/bin/zsh" }
        }
      }
    }
  },

  "remoteUser": "vscode",
  "postCreateCommand": "sudo chown vscode:vscode /commandhistory 2>/dev/null; npm install && .devcontainer/post-create.sh"
}
