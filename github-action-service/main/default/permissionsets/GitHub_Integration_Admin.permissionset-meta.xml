<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description
  >Grants access to GitHub Integration features including triggering workflows and managing settings</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>GitHub Integration Admin</label>
    <classAccesses>
        <apexClass>GitHubAppAuthService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>GitHubActionsService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>GitHubWebhookService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>GitHub_App_Settings__mdt</name>
    </customMetadataTypeAccesses>
</PermissionSet>
